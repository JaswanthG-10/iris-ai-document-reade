# Core Settings
PROJECT_NAME="DocuMind AI"

# Security
# Run: openssl rand -hex 32 to generate a strong key
SECRET_KEY="supersecretkey_change_me_in_production"
ALGORITHM="HS256"

# Database & File Storage
# SQLite configuration (default)
DATABASE_URL="sqlite:///./documind.db"
# PostgreSQL configuration (production)
# DATABASE_URL="postgresql://postgres:postgres@localhost:5432/documind"
UPLOAD_DIR="uploads"

# Vector Storage & Search
CHROMA_PERSIST_DIR="chroma_db"
EMBEDDING_MODEL_NAME="all-MiniLM-L6-v2"
RERANKING_ENABLED="false"
RERANK_MODEL_NAME="cross-encoder/ms-marco-MiniLM-L-6-v2"

# LLM Providers (Configure at least one)
